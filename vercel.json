{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/preview.mjs": {
      "includeFiles": "private/site/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/preview?__path=$1" }
  ]
}
